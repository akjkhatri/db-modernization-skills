     "description": "amount received"
    },
    {
     "name": "payment_method_code",
     "type": "text",
     "nullable": false,
     "pii": "none",
     "description": "how paid"
    },
    {
     "name": "provider_token",
     "type": "text",
     "nullable": true,
     "pii": "financial",
     "description": "PSP token; raw card/bank data never stored"
    },
    {
     "name": "created_at",
     "type": "timestamp with time zone",
     "nullable": false,
     "default": "now()",
     "pii": "none",
     "description": "audit"
    },
    {
     "name": "created_by",
     "type": "text",
     "nullable": false,
     "pii": "none",
     "description": "audit"
    },
    {
     "name": "updated_at",
     "type": "timestamp with time zone",
     "nullable": false,
     "default": "now()",
     "pii": "none",
     "description": "audit"
    },
    {
     "name": "updated_by",
     "type": "text",
     "nullable": false,
     "pii": "none",
     "description": "audit"
    },
    {
     "name": "row_version",
     "type": "integer",
     "nullable": false,
     "default": "1",
     "pii": "none",
     "description": "optimistic lock"
    }
   ],
   "primary_key": [
    "payment_id"
   ],
   "unique": [],
   "checks": [
    {
     "name": "amount_positive",
     "expression": "amount > 0"
    }
   ],
   "foreign_keys": [
